{
    "name": "shiny/json-logic-php",
    "description": "A modern, complete PHP implementation of JsonLogic. 601/601 official tests. Zero dependencies. PHP 8.1+.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "json-logic",
        "jsonlogic",
        "json logic",
        "rules engine",
        "rule engine",
        "business rules",
        "feature flags",
        "json"
    ],
    "homepage": "https://github.com/luismoyano/shiny-json-logic-php",
    "support": {
        "source": "https://github.com/luismoyano/shiny-json-logic-php",
        "issues": "https://github.com/luismoyano/shiny-json-logic-php/issues"
    },
    "authors": [
        {
            "name": "Luis Moyano",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "ShinyJsonLogic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShinyJsonLogic\\Tests\\": "tests/"
        }
    }
}
